{
  "name": "neoguardian-insight",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@neoguardian/web",
    "build": "npm run build --workspace=@neoguardian/web",
    "lint": "npm run lint --workspace=@neoguardian/web",
    "test": "npm run test:setup && npm run test:doctor && npm run test:backup && npm run test --workspace=@neoguardian/web",
    "backup": "node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "test:backup": "node --test scripts/backup.test.mjs",
    "test:backup:integration": "node --test scripts/backup.integration.test.mjs",
    "setup": "node scripts/setup.mjs",
    "test:setup": "node --test scripts/setup.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:doctor": "node --test scripts/doctor.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:up": "docker compose -p wvm-pi-e2e -f compose.e2e.yml up -d --build --wait",
    "test:e2e:stop": "docker compose -p wvm-pi-e2e -f compose.e2e.yml down",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=24"
  }
}
