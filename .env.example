APP_ENV=development
APP_SECRET_KEY=change-me-with-at-least-32-random-characters

POSTGRES_DB=neoguardian
POSTGRES_USER=neoguardian
POSTGRES_PASSWORD=neoguardian-local-only
DATABASE_URL=postgresql+asyncpg://neoguardian:neoguardian-local-only@database:5432/neoguardian

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
MAX_SCAN_UPLOAD_MB=200
SESSION_COOKIE_NAME=ng_session
SESSION_DURATION_HOURS=8
APP_PUBLIC_URL=http://localhost:3000

# Conta criada somente quando APP_ENV=development. Troque a senha no primeiro uso.
BOOTSTRAP_ADMIN_NAME=Administrador local
BOOTSTRAP_ADMIN_EMAIL=admin@neoguardian.com
BOOTSTRAP_ADMIN_PASSWORD=local-demo-change-this-2026!
BOOTSTRAP_CLIENT_NAME=Ambiente de demonstração
BOOTSTRAP_CLIENT_SLUG=demo

# IA de remediação. Provedores implementados: anthropic e openai.
# Use "disabled" enquanto nenhuma chave estiver configurada.
AI_PROVIDER=disabled
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=2200
# Troque esta versão sempre que alterar o prompt de produção.
AI_PROMPT_VERSION=2026-09-04-v2

# Anthropic / Claude Haiku 4.5
ANTHROPIC_API_KEY=
# Necessário apenas para chaves pessoais/serviço com acesso a múltiplos workspaces.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_INPUT_PRICE_PER_MILLION_USD=1.00
ANTHROPIC_OUTPUT_PRICE_PER_MILLION_USD=5.00

# OpenAI (alternativa pronta para troca pelo AI_PROVIDER)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_INPUT_PRICE_PER_MILLION_USD=0.75
OPENAI_OUTPUT_PRICE_PER_MILLION_USD=4.50

# Tickets. Use "disabled" até preencher a configuração do Jira.
TICKET_PROVIDER=disabled
JIRA_BASE_URL=https://sua-empresa.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
JIRA_TIMEOUT_SECONDS=20
# Desativado por padrão: evita enviar endereço/FQDN do ativo para um serviço externo.
JIRA_INCLUDE_ASSET_DETAILS=false

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://api:8000/api/v1
